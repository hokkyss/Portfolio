{
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "html",
    "markdown",
    "json",
    "jsonc",
    "yaml",
    "xml",
    "gql",
    "css",
    "less",
    "scss",
    "pcss",
    "postcss",
    "svg"
  ],
  "tailwindCSS.experimental.classRegex": [
    // Taken from https://github.com/tailwindlabs/tailwindcss/discussions/7554
    ["tw\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    "tw\\`([^`]*)\\`"
  ],
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "never"
  },
  "editor.formatOnSave": false,
  "prettier.enable": false,
  "files.eol": "\n",
  "editor.tabSize": 2,
  "search.exclude": {
    "**/.yarn": true,
    "**/routeTree.gen.ts": true,
    "**/.pnp.*": true
  },
  "eslint.debug": true,
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "files.watcherExclude": {
    "**/routeTree.gen.ts": true
  },
  "files.readonlyInclude": {
    "**/routeTree.gen.ts": true
  },
  "kiroAgent.configureMCP": "Enabled",
  "kiroAgent.enableTabAutocomplete": true,
  "kiroAgent.enableDebugLogs": true,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "typescript.suggest.autoImports": true,
  "typescript.updateImportsOnPaste.enabled": true,
  "typescript.tsc.autoDetect": "on",
  "typescript.preferences.includePackageJsonAutoImports": "on",
  "typescript.tsdk": "apps/public-tanstack-start/node_modules/typescript/lib",
  "typescript.preferences.importModuleSpecifier": "non-relative",
  "typescript.preferences.jsxAttributeCompletionStyle": "braces",
  "typescript.autoClosingTags": true,
  "typescript.inlayHints.variableTypes.enabled": true,
  "typescript.inlayHints.enumMemberValues.enabled": true,
  "editor.inlayHints.enabled": "on",
  "typescript.inlayHints.parameterNames.enabled": "all",
  "typescript.inlayHints.parameterTypes.enabled": true,
  "typescript.inlayHints.functionLikeReturnTypes.enabled": true,
  "typescript.inlayHints.propertyDeclarationTypes.enabled": true,
  "tailwindCSS.lint.suggestCanonicalClasses": "error",
  "tailwindCSS.codeActions": true,
  "editor.defaultFormatter": "dbaeumer.vscode-eslint",
  "reactCompilerMarker.babelPluginPath": "apps/public-tanstack-start/node_modules/babel-plugin-react-compiler"
}
